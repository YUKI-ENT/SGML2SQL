{
  "db": {
    "host": "localhost",
    "port": 5432,
    "dbname": "OQSDrug_data",
    "user": "postgres",
    "password": ""
  },
  "ollama_url": "http://localhost:11434/api/generate",
  "ollama_model": "gemma3:4b",
  "chunk_length": 2000,
  "chunk_overlap": 100,
  "ollama_timeout": 120,
  "gpu_cooling_wait": 15,
  "sgml_note_definitions": "sgml_note_definitions.json",
  "note_ollama_url": "http://localhost:11434/api/generate",
  "note_ollama_model": "gpt-oss:20b",
  "note_ollama_timeout": 600,
  "note_baseline_download_date": null,
  "note_prompt_version": "sgml-note-v4",
  "note_llm_wait": 0,
  "note_llm_max_retries": 2,
  "note_max_block_length": 3000,
  "note_block_extractor_version": "sgml-block-v7",
  "note_included_top_sections": [
    "Warnings", "ContraIndications", "ImportantPrecautions",
    "UseInSpecificPopulations", "AdverseEvents",
    "InfluenceOnLaboratoryValues", "OverDosage", "OtherPrecautions",
    "Pharmacokinetics", "ResultsOfClinicalTrials", "EfficacyPharmacology"
  ],
  "DI_folder": "./SGML/pmda_all_sgml_xml_20251116/SGML_XML/",
  "sgml_use_file_list_dates": true,
  "sgml_update_lookback_months": 1,
  "sgml_table": "public.sgml_rawdata",
  "sgml_interaction_table": "public.sgml_interaction",
  "sgml_note_update_state_table": "public.sgml_note_update_state",
  "sgml_note_document_state_table": "public.sgml_note_document_state",
  "sgml_note_block_table": "public.sgml_note_block",
  "temp_sgml_note_candidate_table": "public.temp_sgml_note_candidate",
  "temp_sgml_note_run_table": "public.temp_sgml_note_run",
  "temp_sgml_note_fact_table": "public.temp_sgml_note_fact",
  "sgml_note_table": "public.sgml_note",
  "sgml_women_table": "public.sgml_women",
  "sgml_women_risk_table": "public.sgml_women_risk_labels",
  "batch_size": 500,
  "progress_every": 2000
}
